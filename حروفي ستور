<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  :root{--primary:#6D1A22;--primary-dark:#4F1119;--gold:#C9A227;--gold-dark:#8B6914;--cream:#FBF7F2;--cream-dark:#F4E6DC;--text:#2B1810;--muted:#7A5C50;--border:#EFE2D6}
  html{scroll-behavior:smooth}
  body{font-family:'Tajawal',sans-serif;background:var(--cream);color:var(--text);line-height:1.7;-webkit-font-smoothing:antialiased}
  header{background:rgba(255,255,255,.96);border-bottom:1px solid var(--border);padding:14px 20px;position:sticky;top:0;z-index:50;backdrop-filter:blur(8px)}
  .header-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:12px}
  .logo{display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;font-weight:800;font-size:19px;color:var(--primary)}
  .logo-text small{display:block;font-weight:500;font-size:11px;color:var(--muted);margin-top:-2px}
  .header-links{display:flex;align-items:center;gap:14px}
  .header-links a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;transition:color .2s}
  .header-links a:hover{color:var(--primary)}
  .header-cta{background:var(--primary);color:#fff !important;padding:8px 16px;border-radius:8px;font-weight:700 !important}
  @media(max-width:640px){.header-links a:not(.header-cta){display:none}}
  .hero{padding:60px 20px 50px;text-align:center;background:linear-gradient(160deg,var(--cream),var(--cream-dark));position:relative;overflow:hidden}
  .hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 20%,rgba(109,26,34,.06),transparent 50%),radial-gradient(circle at 80% 80%,rgba(201,162,39,.08),transparent 50%);pointer-events:none}
  .hero-inner{max-width:820px;margin:0 auto;position:relative;z-index:1}
  .hero-badge{display:inline-block;background:#fff;border:1px solid var(--border);color:var(--primary);padding:6px 16px;border-radius:20px;font-size:13px;font-weight:700;margin-bottom:20px}
  .hero h1{font-size:clamp(26px,5vw,42px);font-weight:900;color:var(--primary);line-height:1.3;margin-bottom:16px}
  .hero h1 .gold{color:var(--gold-dark)}
  .hero p{font-size:clamp(15px,2vw,17px);color:var(--muted);margin-bottom:28px;max-width:600px;margin-inline:auto}
  .hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .btn{display:inline-block;padding:13px 28px;border-radius:10px;font-weight:700;text-decoration:none;font-size:15px;transition:all .2s;border:none;cursor:pointer;font-family:inherit}
  .btn-primary{background:var(--primary);color:#fff}
  .btn-primary:hover{background:var(--primary-dark);transform:translateY(-1px)}
  .btn-outline{background:transparent;color:var(--primary);border:2px solid var(--primary)}
  .btn-outline:hover{background:var(--primary);color:#fff}
  .trust{padding:30px 20px;background:#fff;border-bottom:1px solid var(--border)}
  .trust-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
  .trust-item{display:flex;align-items:center;gap:12px;padding:12px}
  .trust-icon{font-size:26px;flex-shrink:0}
  .trust-item strong{display:block;font-size:14px;color:var(--text)}
  .trust-item span{font-size:12px;color:var(--muted)}
  .container{max-width:1200px;margin:0 auto;padding:50px 20px 60px}
  .section-head{text-align:center;margin-bottom:36px}
  .section-head h2{font-size:clamp(22px,3vw,30px);font-weight:900;color:var(--primary);margin-bottom:8px}
  .section-head p{color:var(--muted);font-size:15px}
  .products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}
  .card{background:#fff;border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:0 2px 10px rgba(109,26,34,.05);display:flex;flex-direction:column;transition:all .25s;position:relative}
  .card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(109,26,34,.14);border-color:#E8D5C5}
  .card-media{position:relative;width:100%;aspect-ratio:4/3;background:linear-gradient(135deg,var(--cream-dark),#EFE2D6);display:flex;align-items:center;justify-content:center;overflow:hidden}
  .card-media img{width:100%;height:100%;object-fit:cover;display:block}
  .card-media .placeholder{font-size:56px;opacity:.8;user-select:none}
  .badge-discount{position:absolute;top:10px;left:10px;background:var(--primary);color:var(--gold);font-size:12px;font-weight:800;padding:5px 11px;border-radius:20px;box-shadow:0 3px 8px rgba(109,26,34,.35)}
  .badge-soon{position:absolute;top:10px;right:10px;background:#F5E5C9;color:var(--gold-dark);font-size:11px;font-weight:800;padding:4px 10px;border-radius:20px;border:1px solid #E5D4B4}
  .card-body{padding:14px 16px 18px;display:flex;flex-direction:column;flex:1;gap:8px}
  .card-title{font-size:15px;font-weight:700;color:var(--text);line-height:1.4;min-height:42px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .card-desc{font-size:12px;color:var(--muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px;flex:1}
  .price-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .price-old{font-size:13px;color:#A88F81;text-decoration:line-through}
  .price-new{font-size:19px;font-weight:800;color:var(--primary)}
  .btn-buy{display:block;text-align:center;background:var(--primary);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:11px;border-radius:10px;transition:all .2s;border:none;cursor:pointer;font-family:inherit;width:100%;margin-top:auto}
  .btn-buy:hover{background:var(--primary-dark)}
  .btn-buy:disabled{background:#D8CCC2;cursor:not-allowed;color:#8A7568}
  .how{padding:50px 20px;background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .how-inner{max-width:1100px;margin:0 auto}
  .how-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;margin-top:36px}
  .how-step{text-align:center;padding:24px;border-radius:14px;background:var(--cream);border:1px solid var(--border)}
  .how-num{display:inline-flex;width:44px;height:44px;background:var(--primary);color:var(--gold);border-radius:50%;font-weight:900;font-size:18px;align-items:center;justify-content:center;margin-bottom:12px}
  .how-step h3{font-size:16px;font-weight:800;color:var(--primary);margin-bottom:6px}
  .how-step p{font-size:13px;color:var(--muted)}
  .contact{padding:60px 20px;background:linear-gradient(160deg,var(--primary),var(--primary-dark));color:#fff;text-align:center}
  .contact h2{font-size:clamp(22px,3vw,28px);font-weight:900;margin-bottom:10px}
  .contact p{color:rgba(255,255,255,.85);margin-bottom:28px;font-size:15px}
  .contact-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .contact-btn{display:inline-flex;align-items:center;gap:10px;background:#fff;color:var(--primary);padding:13px 26px;border-radius:12px;text-decoration:none;font-weight:700;font-size:15px;transition:all .2s}
  .contact-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.2)}
  .contact-btn.gold{background:var(--gold);color:#3D2C0A}
  .contact-btn svg{width:20px;height:20px}
  footer{background:#2B1810;color:#C4AFA0;padding:30px 20px;text-align:center;font-size:13px}
  footer strong{color:var(--gold)}
  .wa-float{position:fixed;bottom:22px;left:22px;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(37,211,102,.5);z-index:80;text-decoration:none;transition:transform .2s}
  .wa-float:hover{transform:scale(1.08)}
  .wa-float svg{width:30px;height:30px}

  /* === PAYMENT MODAL === */
  .payment-modal{display:none;position:fixed;inset:0;background:rgba(43,24,16,.75);z-index:100;padding:16px;overflow-y:auto;backdrop-filter:blur(4px)}
  .payment-modal.open{display:flex;align-items:flex-start;justify-content:center}
  .payment-panel{background:#fff;border-radius:18px;max-width:560px;width:100%;margin:20px auto;box-shadow:0 25px 70px rgba(0,0,0,.5);overflow:hidden}
  .payment-head{background:var(--primary);color:#fff;padding:16px 20px;display:flex;justify-content:space-between;align-items:center}
  .payment-head h3{font-size:17px;font-weight:800}
  .payment-close{background:rgba(255,255,255,.15);border:none;color:#fff;width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:22px;line-height:1;display:flex;align-items:center;justify-content:center}
  .payment-close:hover{background:rgba(255,255,255,.25)}
  .payment-product{padding:16px 20px;background:var(--cream);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:12px}
  .payment-product .pm-name{font-weight:800;color:var(--text);font-size:15px;flex:1}
  .payment-product .pm-old{font-size:12px;color:#A88F81;text-decoration:line-through;display:block;margin-top:2px}
  .payment-product .pm-price{font-size:22px;font-weight:900;color:var(--primary)}
  .pay-body{padding:20px}
  .pay-step{display:flex;gap:14px;margin-bottom:22px}
  .pay-step:last-child{margin-bottom:0}
  .step-num{flex-shrink:0;width:32px;height:32px;background:var(--primary);color:var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:15px}
  .step-content{flex:1;min-width:0}
  .step-content h4{font-size:15px;font-weight:800;color:var(--primary);margin-bottom:6px}
  .step-content > p{font-size:13px;color:var(--muted);margin-bottom:12px}
  .pay-methods{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  @media(max-width:480px){.pay-methods{grid-template-columns:1fr}}
  .pay-method{background:var(--cream);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center}
  .method-icon{font-size:26px;margin-bottom:4px}
  .pay-method strong{display:block;font-size:13px;color:var(--text);margin-bottom:6px}
  .method-number{font-family:'Courier New',monospace;font-size:17px;font-weight:900;color:var(--primary);letter-spacing:.5px;margin-bottom:8px;direction:ltr}
  .copy-btn{background:var(--primary);color:#fff;border:none;padding:6px 14px;border-radius:6px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:background .2s}
  .copy-btn:hover{background:var(--primary-dark)}
  .copy-btn.copied{background:#16a34a}
  .order-form label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin:10px 0 4px}
  .order-form input,.order-form textarea{width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-family:inherit;font-size:14px;color:var(--text);background:#fff}
  .order-form input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(109,26,34,.08)}
  .order-form input[type=file]{padding:8px;font-size:13px}
  .order-form .btn-submit{width:100%;background:#25D366;color:#fff;border:none;padding:13px;border-radius:10px;font-family:inherit;font-weight:800;font-size:15px;cursor:pointer;margin-top:14px;transition:background .2s;display:flex;align-items:center;justify-content:center;gap:8px}
  .order-form .btn-submit:hover{background:#1DAF54}
  .order-form .btn-submit:disabled{background:#D8CCC2;cursor:not-allowed}
  .order-form .btn-submit svg{width:18px;height:18px}
  .pay-note{background:#E7F5EC;border:1px solid #B8E0C8;color:#1E7A4C;padding:10px 12px;border-radius:8px;font-size:12px;margin-bottom:12px;line-height:1.6}
  .pm-success{padding:36px 24px;text-align:center;display:none}
  .pm-success .success-icon{width:70px;height:70px;background:#E0F2E9;color:#16a34a;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:36px;margin-bottom:16px}
  .pm-success h3{font-size:20px;font-weight:900;color:var(--primary);margin-bottom:10px}
  .success-note{padding:12px;border-radius:8px;border:1px solid;font-size:13px;line-height:1.7;margin-bottom:16px;text-align:right}
  .pm-success .final-msg{font-size:13px;color:var(--muted);margin-bottom:18px}
  .pm-success .actions{display:flex;gap:8px;flex-wrap:wrap}
  .pm-success button{border:none;padding:11px 20px;border-radius:10px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;flex:1;min-width:120px}
  .pm-success .btn-wa-success{background:#25D366;color:#fff}
  .pm-success .btn-close-success{background:var(--primary);color:#fff}
  .toast{position:fixed;bottom:100px;right:50%;transform:translateX(50%);background:var(--primary);color:#fff;padding:11px 22px;border-radius:10px;font-size:14px;font-weight:700;z-index:200;opacity:0;pointer-events:none;transition:opacity .3s;box-shadow:0 8px 24px rgba(0,0,0,.3);max-width:90vw;text-align:center}
  .toast.show{opacity:1}

  /* === ADMIN === */
  .admin-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:110;padding:16px;overflow-y:auto}
  .admin-modal.open{display:block}
  .admin-panel{max-width:600px;margin:20px auto;background:#fff;border-radius:16px;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.4)}
  .admin-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border)}
  .admin-head h3{font-size:18px;color:var(--primary);font-weight:900}
  .admin-close{background:#F4E6DC;border:none;width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:20px;color:var(--primary)}
  .admin-note{background:#FFF8E7;border:1px solid #F0DFA0;color:#7A5C00;padding:10px 12px;border-radius:8px;font-size:12px;margin-bottom:14px;line-height:1.6}
  .admin-list{max-height:50vh;overflow-y:auto;border:1px solid var(--border);border-radius:10px;padding:8px}
  .admin-item{padding:12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;font-size:13px}
  .admin-item:last-child{border-bottom:none}
  .admin-item strong{flex:1;color:var(--text)}
  .admin-item .status{font-size:11px;padding:2px 8px;border-radius:6px;font-weight:700}
  .admin-item .status.filled{background:#E0F2E9;color:#1E7A4C}
  .admin-item .status.empty{background:#F0E5DB;color:#8A7568}
  .admin-item button{background:var(--primary);color:#fff;border:none;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:700}
  .admin-form{display:none}
  .admin-form.open{display:block}
  .admin-form label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin:10px 0 4px}
  .admin-form input,.admin-form textarea{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:8px;font-family:inherit;font-size:14px;color:var(--text)}
  .admin-form .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .admin-form .actions{display:flex;gap:8px;margin-top:16px}
  .admin-form .actions button{flex:1;padding:10px;border-radius:8px;border:none;cursor:pointer;font-family:inherit;font-weight:700;font-size:14px}
  .admin-form .save{background:var(--primary);color:#fff}
  .admin-form .cancel{background:#F4E6DC;color:var(--primary)}
  .admin-tools{margin-top:14px;padding-top:14px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap}
  .admin-tools button{flex:1;min-width:120px;padding:10px;border-radius:8px;border:1px solid var(--primary);background:#fff;color:var(--primary);cursor:pointer;font-family:inherit;font-weight:700;font-size:13px}
  .admin-tools button:hover{background:var(--primary);color:#fff}
  .admin-tools .danger{border-color:#C33;color:#C33}
  .admin-tools .danger:hover{background:#C33;color:#fff}
  .code-output{display:none;margin-top:14px}
  .code-output.open{display:block}
  .code-output textarea{width:100%;height:180px;padding:10px;border-radius:8px;border:1px solid var(--border);font-family:monospace;font-size:11px;background:#FBF7F2;color:var(--text)}
  .code-output .hint{font-size:12px;color:var(--muted);margin:6px 0}
  .code-output button{padding:8px 16px;border-radius:8px;border:none;background:var(--primary);color:#fff;cursor:pointer;font-family:inherit;font-weight:700;font-size:13px;margin-top:6px}
</style>
</head>
